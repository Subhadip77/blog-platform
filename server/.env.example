NODE_ENV=development
PORT=5001
MONGO_URI=mongodb+srv://USER:PASSWORD@your-cluster.mongodb.net/blog-platform?retryWrites=true&w=majority
MONGO_URI_TEST=mongodb+srv://USER:PASSWORD@your-cluster.mongodb.net/blog-platform-test?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5001
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
JWT_ACCESS_SECRET=generate-a-random-string-min-32-chars
JWT_REFRESH_SECRET=generate-a-different-random-string-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
